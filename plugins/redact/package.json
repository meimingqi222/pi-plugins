{
  "name": "pi-redact",
  "version": "0.1.0",
  "description": "pi extension that redacts API keys, tokens, passwords and other secrets from every payload sent to the model — before it leaves your machine.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine.ts",
    "./patterns": "./src/patterns.ts",
    "./bridge": "./src/pi-bridge.ts",
    "./service": "./src/service.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun bench/bench.ts",
    "bench:patterns": "bun bench/profile-patterns.ts"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "redact",
    "secret",
    "privacy",
    "security",
    "sanitize",
    "pii"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.6.0"
  }
}
