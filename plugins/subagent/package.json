{
	"name": "@meimingqi222/pi-subagent",
	"version": "0.1.0",
	"description": "Delegate a single task to an isolated subagent: background execution with automatic answer delivery.",
	"type": "module",
	"main": "./src/index.ts",
	"exports": { ".": "./src/index.ts", "./transcript": "./src/transcript.ts", "./logs": "./src/logs.ts" },
	"files": ["src", "README.md", "ATTRIBUTION.md"],
	"pi": { "extensions": ["./src/index.ts"] },
	"scripts": { "test": "bun test --isolate", "typecheck": "tsc --noEmit" },
	"keywords": ["pi", "pi-package", "subagent", "delegation", "agent"],
	"license": "MIT",
	"peerDependencies": { "@earendil-works/pi-coding-agent": ">=1.0.0", "@earendil-works/pi-tui": ">=1.0.0", "typebox": "*" },
	"dependencies": { "@meimingqi222/pi-agent-runner": "workspace:*", "@meimingqi222/pi-run-core": "workspace:*" },
	"devDependencies": {
		"@earendil-works/pi-tui": "^1.0.0",
		"@types/node": "^22.0.0",
		"bun-types": "^1.4.2",
		"typebox": "^1.3.7",
		"typescript": "^5.6.0"
	}
}
