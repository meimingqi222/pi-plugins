{
  "name": "@meimingqi222/pi-goal",
  "version": "0.1.0",
  "description": "Persistent, user-controlled goals for pi sessions.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "pi-package",
    "goal",
    "continuation"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "typebox": "*"
  },
  "dependencies": {
    "@meimingqi222/pi-run-core": "workspace:*",
    "@meimingqi222/pi-redact-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.2",
    "typebox": "^1.3.7",
    "typescript": "^5.6.0"
  }
}
