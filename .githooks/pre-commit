#!/bin/sh
# Pre-commit gates:
#
#   1. Regression notes — a bug fix cannot land without its note and bound test.
#   2. Credential-shaped fixtures — a literal secret in the source would make
#      GitHub push protection refuse the push, and it scans *commits*, so a
#      literal that reaches a commit is far more expensive to remove than one
#      caught here.
#
# Activated by `git config core.hooksPath .githooks`.
#
# Only fast, path/content-based checks run here. Run `bun run test` and
# `bun run typecheck` yourself, or wire them into CI.
set -e

# Resolve the repo root from this script's location, not the caller's cwd.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# --- 1. credential-shaped literals ------------------------------------------
# Runs the guard test, which scans the working tree (a git-aware staged-only
# variant would be nice, but the test is the single source of truth for the
# rule and duplicating its logic here would let the two drift).
if command -v bun >/dev/null 2>&1; then
  if ! (cd "$root" && bun run secrets >/dev/null 2>&1); then
    echo "pre-commit: credential-shaped literal detected in the source." >&2
    echo "  Move the value to plugins/redact/test/fixtures.ts and split it so" >&2
    echo "  neither half matches a rule. Details: AGENTS.md." >&2
    echo "  Re-run the check: bun run secrets" >&2
    exit 1
  fi
fi
# --- 2. regression notes ----------------------------------------------------
sh "$root/scripts/verify-notes.sh"
